{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeMark",
  "version": "0.1.1",
  "identifier": "jp.myon778.timemark",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TimeMark",
        "width": 1180,
        "height": 820,
        "minWidth": 390,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "目標日までの時間と学習計画を管理するアプリ",
    "longDescription": "TimeMark は目標日までの時間と学習計画を端末内で管理し、必要に応じてGoogleスプレッドシートと同期できるアプリです。"
  }
}
